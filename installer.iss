[Setup]
AppName=PhoneTest Suite 
AppVersion=1.0.0
AppPublisher=Your Company Name
DefaultDirName={autopf}\PhoneTest Suite 
DefaultGroupName=PhoneTest Suite 
OutputDir=.
OutputBaseFilename=PhoneTest Suite _Setup_v1.0.0
Compression=lzma2/max
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64
WizardStyle=modern
SetupIconFile=

[Files]
